{
  "name": "omnigallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check:react": "tsc --project tsconfig.react.json --noEmit",
    "test": "node --test \"src/**/*.test.mjs\" \"react/**/*.test.mjs\"",
    "build": "vue-tsc --noEmit && npm run type-check:react && vite build",
    "tauri": "tauri",
    "tauri-build": "tauri build",
    "tauri-build-debug": "tauri build --debug",
    "lint": "eslint src react vite.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run type-check:react && npm test && npm run build-only",
    "build-only": "vite build"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@crabnebula/tauri-plugin-drag": "2.1.0",
    "@dagrejs/dagre": "^3.1.1",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@noble/hashes": "2.4.0",
    "@tabler/icons-react": "3.48.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "15.0.0",
    "@xyflow/react": "^12.12.0",
    "ant-design-vue": "4.2.6",
    "axios": "1.20.0",
    "diff-match-patch": "1.0.5",
    "js-cookie": "3.0.8",
    "lodash-es": "4.18.1",
    "multi-nprogress": "0.3.5",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vue": "3.5.43",
    "vue-diff": "1.2.4",
    "vue-i18n": "11.4.12",
    "vue-virtual-scroller": "3.0.5",
    "vue3-ts-util": "2.1.4"
