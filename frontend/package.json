{
  "name": "omnigallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\" \"react/**/*.test.mjs\"",
    "build": "npm run type-check && vite build",
    "tauri": "tauri",
    "tauri-build": "tauri build",
    "tauri-build-debug": "tauri build --debug",
    "lint": "eslint src react vite.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run type-check && npm test && npm run build-only",
    "build-only": "vite build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@noble/hashes": "2.4.0",
    "@tabler/icons-react": "3.48.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@xyflow/react": "^12.12.0",
    "diff-match-patch": "1.0.5",
    "js-cookie": "3.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "@typescript-eslint/eslint-plugin": "8.70.1"
  },
  "engines": {
    "node": "24.x"
  }
